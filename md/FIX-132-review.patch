+    @Bean Object requireObservationMode(Environment env) {
+        if(!"OBSERVE".equals(env.getProperty("shared-market.mode","OFF")))
+            throw new IllegalStateException("FIX-132 approval console requires OBSERVE; never LIVE");
+        return new Object();
+    }
+}
