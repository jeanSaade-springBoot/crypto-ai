+      rsi-recovering: 45
+      rsi-bullish: 50
+      rsi-strong: 60
+      rsi-hot: 68
+      rsi-overbought: 72
+      macd-atr-weak: 2
+      macd-atr-moderate: 5
+      macd-atr-strong: 10
+    data-quality:
+      minimum-candles: 210
+      maximum-missing-candles: 0
+      block-on-invalid-ohlc: true
+
+  # Market-driven strategy selection. The system first classifies the current
