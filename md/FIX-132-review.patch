+  dynamic-strategy:
+    enabled: ${DYNAMIC_STRATEGY_ENABLED:true}
+    version: ${DYNAMIC_STRATEGY_VERSION:1.0}
+    minimum-regime-confidence: ${DYNAMIC_STRATEGY_MINIMUM_CONFIDENCE:55}
+
+    trend-following:
+      trend-maximum: 30
+      volume-maximum: 20
+      momentum-maximum: 15
+      sentiment-maximum: 10
+      fundamental-maximum: 10
+      strong-buy-threshold: 85
+      buy-threshold: 75
+      watch-threshold: 60
+      neutral-threshold: 45
+      sell-threshold: 30
+
+    range-mean-reversion:
+      trend-maximum: 15
+      volume-maximum: 18
+      momentum-maximum: 22
+      sentiment-maximum: 15
+      fundamental-maximum: 15
+      strong-buy-threshold: 88
+      buy-threshold: 78
+      watch-threshold: 65
+      neutral-threshold: 45
+      sell-threshold: 30
+
+    breakout:
+      trend-maximum: 20
+      volume-maximum: 30
+      momentum-maximum: 20
+      sentiment-maximum: 10
+      fundamental-maximum: 5
+      strong-buy-threshold: 90
+      buy-threshold: 80
+      watch-threshold: 65
+      neutral-threshold: 45
+      sell-threshold: 30
+
+    defensive:
