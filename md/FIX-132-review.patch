+            int fundamentals,
+            boolean sentimentEnabled,
+            boolean sentimentAvailable,
+            boolean fundamentalAvailable,
+            int rawTotal,
+            int maximumAvailableScore,
+            int normalizedTotal
+    ) {
+        List<String> reasons = new ArrayList<>();
+        reasons.add("Trend " + trend + "/25");
