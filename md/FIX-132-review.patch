+            log.info(
+                    "Automatic candle flow completed: symbol={}, interval={}, openTime={}, score={}, decision={}, paperPositionOpened={}",
+                    indicator.getSymbol(), indicator.getIntervalCode(), indicator.getCandleOpenTime(),
