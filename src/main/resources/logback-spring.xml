<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- FIX-142: retain normal application console logs; route high-volume JDBC
         diagnostics to a separate bounded rolling file. Trading threads only offer
         events to JdbcTimingDataSource's bounded queue; this appender runs on its writer. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <!-- Keep the deployment's existing per-environment log-directory contract. -->
    <springProperty scope="context" name="LOG_DIR" source="diagnostics.jdbc.log-directory" defaultValue="logs"/>
    <appender name="DATABASE_TIMING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/database-timing.log</file>
        <immediateFlush>true</immediateFlush>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/database-timing.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>256MB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date{yyyy-MM-dd'T'HH:mm:ss.SSS,UTC} %-5level %msg%n</pattern></encoder>
    </appender>
    <logger name="FIX142.DatabaseTiming" level="INFO" additivity="false"><appender-ref ref="DATABASE_TIMING"/></logger>
    <!-- FIX-150: Eclipse console rollover must not be the only original-error trail.
         Bounded asynchronous file delivery avoids waiting on file I/O in trading threads.
         Queue saturation may drop file events; the guarded DB failure/audit remains primary. -->
    <appender name="APPLICATION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/crypto-ai-trader.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/crypto-ai-trader.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>25MB</maxFileSize><maxHistory>7</maxHistory><totalSizeCap>256MB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date{yyyy-MM-dd'T'HH:mm:ss.SSS,UTC} %-5level [%thread] %logger{40} : %msg%n%ex</pattern></encoder>
    </appender>
    <appender name="ASYNC_APPLICATION" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize><discardingThreshold>0</discardingThreshold><neverBlock>true</neverBlock>
        <appender-ref ref="APPLICATION_FILE"/>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="ASYNC_APPLICATION"/></root>
</configuration>
